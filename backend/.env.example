# Environment variables for LELLAMA Sri Lanka Marine PFZ & Alert System
# Copy to .env and replace secrets for production deployment

# Application Configuration
PROJECT_NAME="Lellama Marine PFZ & Safety Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY="insecure-dev-secret-key-change-in-production-marine-platform"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 Hours offline endurance

# Database Connection (PostgreSQL + PostGIS)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="lellama_admin"
POSTGRES_PASSWORD="secure_marine_password"
POSTGRES_DB="lellama_marine"
DATABASE_URL="postgresql+psycopg://lellama_admin:secure_marine_password@localhost:5432/lellama_marine"

# Redis Cache & Celery Broker
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting
RATE_LIMIT_DEFAULT="60/minute"
RATE_LIMIT_SYNC="10/minute"
RATE_LIMIT_AUTH="15/minute"

# Alerting Gateways
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
FCM_SERVER_KEY=""

# Marine Remote Sensing & Weather API Keys
COPERNICUS_USERNAME=""
COPERNICUS_PASSWORD=""
STORMGLASS_API_KEY=""
